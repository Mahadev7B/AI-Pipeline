[Unit]
Description=ai-pipeline opsdb broker (TASK-023) — the only process besides a human/CLI that opens operations.sqlite3 on behalf of a sandboxed Developer session
Documentation=file:///home/user/AI-Pipeline/ops/reviews/cto-task023-architecture.md file:///home/user/AI-Pipeline/ops/reviews/task023-os-provisioning-runbook.md
After=network.target

[Service]
Type=simple
# ============================ REQUIRED EDIT ============================
# This unit MUST NOT run as root (B2.3, Code Review REJECT): a systemd unit
# with no User= defaults to root, which both violates least-privilege AND
# breaks session registration — opsdb_broker._default_trusted_uids() would
# then be {0}, so the Founder-UID launcher's SO_PEERCRED-gated
# register_session is refused on every launch. Per the architecture doc
# (ops/reviews/cto-task023-architecture.md §3 point 2): the broker runs as
# "the Founder's own user, or a dedicated trusted ai-pipeline-broker system
# account — never as ai-developer".
#
# The placeholders below are intentionally NOT valid, so this unit FAILS
# LOUDLY (systemd refuses to start it) until a human sets them — fail
# closed, never fall back to root. Pick ONE option, per the runbook:
#
#   Option A (simplest — broker runs as the Founder's own account, which is
#   the same account launch_developer_session.py runs as, so
#   _default_trusted_uids() already resolves to the launcher's UID with NO
#   extra config): set User=/Group= to that account and its primary group;
#   leave OPSDB_BROKER_TRUSTED_UIDS unset.
#
#   Option B (dedicated broker account): set User=ai-pipeline-broker,
#   Group=ai-pipeline-db, AND uncomment the OPSDB_BROKER_TRUSTED_UIDS line
#   below with the Founder's numeric UID (`id -u <founder-user>`) so the
#   launcher — a different UID than the broker — can still register.
User=__REPLACE_WITH_FOUNDER_USER_OR_ai-pipeline-broker__
# Group is NOT a placeholder, under EITHER option: it must be ai-pipeline-db,
# because systemd chowns RuntimeDirectory= to this unit's User=/Group= on
# start, overriding the runbook's manual chgrp. With the Founder's own
# primary group here (Option A's naive reading), /run/ai-pipeline becomes
# 0770 founder:foundergroup and ai-developer cannot traverse it to reach
# either socket (Code Review non-blocking item). The Founder's account keeps
# DB access as the file's OWNER, and systemd still grants it all of its
# supplementary groups, so pinning the primary group here costs nothing.
# The invalid User= above is what keeps this unit failing closed (217/USER).
Group=ai-pipeline-db
# Environment=OPSDB_BROKER_TRUSTED_UIDS=__FOUNDER_NUMERIC_UID__   # Option B only
# ======================================================================
WorkingDirectory=/home/user/AI-Pipeline
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/user/AI-Pipeline/ops/control-center/opsdb_broker.py
Restart=on-failure
RestartSec=5
# The socket directory (/run/ai-pipeline) is created and chowned to
# User=/Group= by systemd. It is SHARED with egress-proxy.service, so
# RuntimeDirectoryPreserve=yes is required: without it, stopping either unit
# deletes the directory out from under the other one, taking its socket with
# it (Code Review non-blocking item). See the runbook, step 5.
RuntimeDirectory=ai-pipeline
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes

# Defense in depth beyond the application-level controls already in
# opsdb_broker.py itself (the 5-verb allowlist, session-token binding,
# SO_PEERCRED-gated registration) — standard systemd sandboxing for a
# process that, unlike ai-developer's own bwrap sandbox, DOES need real
# read/write access to operations.sqlite3.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/user/AI-Pipeline/ops/db /run/ai-pipeline
ProtectHome=false

[Install]
WantedBy=multi-user.target
